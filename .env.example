# Copia este archivo como .env.local y rellena los valores.
# Supabase > Project Settings > API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Nunca pongas aqui la secret key (sb_secret_...) ni la service_role.

# Jax (asistente). Clave de Google AI Studio; solo servidor, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional: modelo principal de Gemini (por defecto gemini-3.8-flash)
GEMINI_MODEL=
# Opcional: modelo de respaldo si el principal está saturado (por defecto gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODEL=
