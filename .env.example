# Copia este archivo como .env.local y rellena los valores.
# Supabase > Project Settings > API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Nunca pongas aqui la secret key (sb_secret_...) ni la service_role.

# Jax (asistente). Clave de Google AI Studio; solo servidor, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional: modelo principal de Gemini (por defecto gemini-3.8-flash)
GEMINI_MODEL=
# Opcional: modelo de respaldo si el principal está saturado (por defecto gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODEL=

# Correo UJI y Google Calendar (OAuth de Google Cloud; activar Gmail API y Google Calendar API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_TOKEN_KEY=

# Avisos push (Web Push). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# Tareas en segundo plano (recordatorios, revisión del correo, sincronización del calendario).
# pg_cron llama a /api/cron/* con este secreto (mín. 32 caracteres), guardado también en Supabase Vault.
CRON_SECRET=
# Supabase > Project Settings > API Keys > Secret key. SOLO servidor; solo lo usan las rutas /api/cron/*.
SUPABASE_SECRET_KEY=
